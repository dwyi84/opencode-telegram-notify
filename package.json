{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-telegram-notify",
  "version": "0.3.5",
  "description": "Telegram notifications for opencode session events - completion, errors, and permission requests",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "telegram",
    "notification",
    "bot"
  ],
  "author": "dwyi84",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dwyi84/opencode-telegram-notify.git"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.18",
    "@types/bun": "^1.2.0",
    "typescript": "^5.9.0"
  }
}
